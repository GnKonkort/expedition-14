<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">

    <lobbyUi:LobbyBlackHoleControl Access="Public" Name="AnimatedBackground"
                                   HorizontalExpand="True" VerticalExpand="True" />
    <lobbyUi:LobbyFxOverlay Name="FxOverlay" MouseFilter="Ignore" />
    <TextureRect Access="Public" Name="Background" Visible="False" />

    <BoxContainer Name="MainContainer" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <!-- LEFT: brand / chat / votes over the void -->
        <BoxContainer Name="LeftSide" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Control Name="DefaultState" VerticalExpand="True" HorizontalExpand="True">
                <!-- Brand -->
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="36 36 0 0" SeparationOverride="2">
                    <BoxContainer Name="PixelLogo" Access="Public" Margin="0 0 0 10" />
                    <Label Text="{Loc 'ui-lobby-expedition-brand'}"
                           StyleClasses="ExpeditionLobbyBrandTitle"
                           FontColorOverride="#F0A830" />
                    <Label Text="{Loc 'ui-lobby-expedition-subtitle'}"
                           StyleClasses="ExpeditionLobbyBrandSubtitle"
                           FontColorOverride="#5A4820"
                           Margin="0 4 0 0" />
                    <BoxContainer Name="BrandDash" Access="Public" Orientation="Horizontal"
                                  SeparationOverride="2" Margin="0 8 0 0" />
                    <Label Name="ServerName" Access="Public" Visible="False" />
                </BoxContainer>

                <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="36 150 0 0" SeparationOverride="4" />

                <!-- Chat (resizable) -->
                <BoxContainer Name="ChatShell" Access="Public" Orientation="Vertical"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Margin="36 0 0 36"
                              MinWidth="280" MinHeight="180"
                              MaxWidth="640" MaxHeight="520"
                              SetWidth="300" SetHeight="240">
                    <PanelContainer StyleClasses="ExpeditionLobbyChatPanel" VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" SeparationOverride="8">
                                <PanelContainer MinSize="6 6" MaxSize="6 6" VerticalAlignment="Center">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#F0A830" />
                                    </PanelContainer.PanelOverride>
                                </PanelContainer>
                                <Label Text="{Loc 'ui-lobby-expedition-chat-header'}"
                                       StyleClasses="ExpeditionLobbyGold"
                                       FontColorOverride="#F0A830"
                                       VerticalAlignment="Center" />
                                <Control HorizontalExpand="True" />
                                <Label Name="ChatMsgCount" Access="Public"
                                       Text="0 МСГ"
                                       FontColorOverride="#3A2A10"
                                       StyleClasses="ExpeditionLobbyMuted"
                                       VerticalAlignment="Center" />
                                <!-- Top-right resize grip -->
                                <PanelContainer Name="ChatResizeGrip" Access="Public"
                                                MinSize="14 14" MaxSize="14 14"
                                                ToolTip="Resize"
                                                MouseFilter="Stop"
                                                VerticalAlignment="Center">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#F0A83059" />
                                    </PanelContainer.PanelOverride>
                                </PanelContainer>
                            </BoxContainer>
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True"
                                             HorizontalExpand="True"
                                             Margin="2 0 2 2" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Visible="False">
                        <info:DevInfoBanner Name="DevInfoBanner" />
                        <RichTextLabel Name="LobbySong" Access="Public" />
                        <RichTextLabel Name="PlaytimeComment" Access="Public" />
                    </BoxContainer>
                </BoxContainer>

                <BoxContainer Visible="False">
                    <info:LinkBanner Name="LinkBanner" />
                    <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
                    <Label Name="StartTime" Access="Public" />
                    <Label Name="StationTime" Access="Public" />
                </BoxContainer>
            </Control>

            <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
        </BoxContainer>

        <!-- RIGHT: soft fade rail, vertically centered nav -->
        <Control Name="RightSide" Access="Public" VerticalExpand="True" MinWidth="320" MaxWidth="320">
            <lobbyUi:LobbyNavFadeControl Name="NavFade" />
            <BoxContainer Name="RightSideContent" Orientation="Vertical" VerticalExpand="True"
                          Margin="48 0 40 0">
                <Control VerticalExpand="True" />

                <!-- Centered nav stack -->
                <BoxContainer Orientation="Vertical" SeparationOverride="0">
                    <Label Text="{Loc 'ui-lobby-expedition-nav-header'}"
                           FontColorOverride="#2A1A08"
                           StyleClasses="ExpeditionLobbySectionHeader"
                           Margin="0 0 0 20" />

                    <BoxContainer Name="ReadyCounterBox" Orientation="Vertical" Margin="0 0 0 6"
                                  SeparationOverride="6">
                        <BoxContainer Name="ReadyCounterRow" Orientation="Horizontal" SeparationOverride="12">
                            <BoxContainer Name="ReadySegmentRow" Access="Public" VerticalAlignment="Center" />
                            <RichTextLabel Name="ReadyCountLabel" Access="Public"
                                   VerticalAlignment="Center" />
                        </BoxContainer>
                        <!-- Height-clipped badge — expands smoothly when ready (Figma) -->
                        <Control Name="ReadyBadgeClip" Access="Public" HorizontalAlignment="Left"
                                 RectClipContent="True" MaxHeight="0" MinHeight="0">
                            <PanelContainer Name="ReadyBadge" Access="Public"
                                            StyleClasses="ExpeditionLobbyReadyBadge" HorizontalAlignment="Left">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="10 4">
                                    <PanelContainer Name="ReadyBadgeDot" Access="Public"
                                                    MinSize="6 6" MaxSize="6 6"
                                                    VerticalAlignment="Center">
                                        <PanelContainer.PanelOverride>
                                            <gfx:StyleBoxFlat BackgroundColor="#4AF0D0" />
                                        </PanelContainer.PanelOverride>
                                    </PanelContainer>
                                    <Label Text="{Loc 'ui-lobby-expedition-ready-badge'}"
                                           StyleClasses="ExpeditionLobbyReadyBadgeText"
                                           FontColorOverride="#4AF0D0"
                                           VerticalAlignment="Center" />
                                </BoxContainer>
                            </PanelContainer>
                        </Control>
                    </BoxContainer>

                    <!-- PLAY -->
                    <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                            StyleClasses="ExpeditionLobbyNavButton" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="14" Margin="0 14 0 12">
                            <PanelContainer Name="ReadyAccent" Access="Public"
                                            MinSize="3 8" MaxSize="3 8"
                                            VerticalAlignment="Center">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#2A1A08" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                                <Label Name="ReadyTitle" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-play'}"
                                       StyleClasses="ExpeditionLobbyNavTitle"
                                       FontColorOverride="#5A4020" />
                                <Label Name="PlaySubLabel" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-play-sub'}"
                                       StyleClasses="ExpeditionLobbyNavSub"
                                       FontColorOverride="#1A1008" />
                            </BoxContainer>
                        </BoxContainer>
                    </Button>
                    <PanelContainer Name="ReadyHairline" Access="Public" MinHeight="1" MaxHeight="1" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#2A1A0880" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <!-- CHARACTER -->
                    <Button Name="CharacterNavButton" Access="Public"
                            StyleClasses="ExpeditionLobbyNavButton" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="14" Margin="0 12">
                            <PanelContainer Name="CharacterAccent" Access="Public"
                                            MinSize="3 8" MaxSize="3 8" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#2A1A08" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                                <Label Name="CharacterTitle" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-character'}"
                                       StyleClasses="ExpeditionLobbyNavTitle"
                                       FontColorOverride="#5A4020" />
                                <Label Name="CharacterSub" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-character-sub'}"
                                       StyleClasses="ExpeditionLobbyNavSub"
                                       FontColorOverride="#1A1008" />
                            </BoxContainer>
                        </BoxContainer>
                    </Button>
                    <PanelContainer Name="CharacterHairline" Access="Public" MinHeight="1" MaxHeight="1" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#2A1A0880" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <!-- SETTINGS -->
                    <Button Name="OptionsButton" Access="Public"
                            StyleClasses="ExpeditionLobbyNavButton" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="14" Margin="0 12">
                            <PanelContainer Name="SettingsAccent" Access="Public"
                                            MinSize="3 8" MaxSize="3 8" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#2A1A08" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                                <Label Name="SettingsTitle" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-settings'}"
                                       StyleClasses="ExpeditionLobbyNavTitle"
                                       FontColorOverride="#5A4020" />
                                <Label Name="SettingsSub" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-settings-sub'}"
                                       StyleClasses="ExpeditionLobbyNavSub"
                                       FontColorOverride="#1A1008" />
                            </BoxContainer>
                        </BoxContainer>
                    </Button>
                    <PanelContainer Name="SettingsHairline" Access="Public" MinHeight="1" MaxHeight="1" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#2A1A0880" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <!-- QUIT -->
                    <Button Name="LeaveButton" Access="Public"
                            StyleClasses="ExpeditionLobbyNavButton" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="14" Margin="0 12">
                            <PanelContainer Name="QuitAccent" Access="Public"
                                            MinSize="3 8" MaxSize="3 8" VerticalAlignment="Center">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#2A1A08" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                                <Label Name="QuitTitle" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-quit'}"
                                       StyleClasses="ExpeditionLobbyNavTitle"
                                       FontColorOverride="#5A4020" />
                                <Label Name="QuitSub" Access="Public"
                                       Text="{Loc 'ui-lobby-expedition-quit-sub'}"
                                       StyleClasses="ExpeditionLobbyNavSub"
                                       FontColorOverride="#1A1008" />
                            </BoxContainer>
                        </BoxContainer>
                    </Button>
                    <PanelContainer Name="QuitHairline" Access="Public" MinHeight="1" MaxHeight="1" HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#2A1A0880" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>

                    <Label Text="{Loc 'ui-lobby-expedition-footer'}"
                           FontColorOverride="#1A1008"
                           StyleClasses="ExpeditionLobbySectionHeader"
                           Margin="0 28 0 0" />

                    <BoxContainer Visible="False">
                        <Button Name="AHelpButton" Access="Public" />
                        <vote:VoteCallMenuButton Name="CallVoteButton" />
                        <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                        <TextureButton Name="CollapseButton" />
                        <ProgressBar Name="ReadyProgress" Access="Public" MinValue="0" MaxValue="1" />
                    </BoxContainer>
                </BoxContainer>

                <Control VerticalExpand="True" />
            </BoxContainer>
        </Control>

        <PanelContainer Name="ExpandPanel" Visible="False">
            <TextureButton Name="ExpandButton" />
        </PanelContainer>
    </BoxContainer>

    <!-- Status pips — top-right of the full screen (Figma) -->
    <BoxContainer Name="StatusPips" Orientation="Horizontal"
                  Margin="0 32 32 0" SeparationOverride="14">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <PanelContainer MinSize="6 6" MaxSize="6 6" VerticalAlignment="Center">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#F0A830" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <Label Text="NET" StyleClasses="ExpeditionLobbyGold" FontColorOverride="#F0A830" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <PanelContainer MinSize="6 6" MaxSize="6 6" VerticalAlignment="Center">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#C07020" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <Label Text="SRV" StyleClasses="ExpeditionLobbyGold" FontColorOverride="#C07020" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <PanelContainer MinSize="6 6" MaxSize="6 6" VerticalAlignment="Center">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1A1008" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <Label Text="VCE" FontColorOverride="#2A1A08" StyleClasses="ExpeditionLobbyMuted" />
        </BoxContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
